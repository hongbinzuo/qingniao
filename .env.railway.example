# Railway Environment Variables Template
# Copy these to your Railway project's environment variables

# ============================================================================
# DATABASE CONFIGURATION (Railway PostgreSQL)
# ============================================================================
# Railway will automatically provide DATABASE_URL when you add PostgreSQL service
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway
#
# If you prefer PG_* variables, set these instead (DATABASE_URL can be omitted):
# PG_HOST=containers-us-west-xxx.railway.app
# PG_PORT=5432
# PG_DATABASE=railway
# PG_USER=postgres
# PG_PASSWORD=your_password
# PG_POOL_MIN_SIZE=2
# PG_POOL_MAX_SIZE=10

# ============================================================================
# SCANNER CONFIGURATION
# ============================================================================

# Scan interval in minutes (default: 15)
# Recommended: 15 for active trading, 30 for moderate, 60 for conservative
SCAN_INTERVAL_MINUTES=15

# Number of top coins to scan (default: 10)
# More coins = longer scan time
# 10 coins ≈ 30-45s, 20 coins ≈ 60-90s
TOP_COINS=10

# Timeframes to scan (comma-separated, no spaces)
# Options: 5m, 15m, 1h
# Default: 5m,15m,1h
TIMEFRAMES=5m,15m,1h

# Signal modes to run (comma-separated, no spaces)
# Options: aggressive, neutral, conservative
# Default: aggressive,neutral,conservative
SIGNAL_MODES=aggressive,neutral,conservative

# ============================================================================
# SIGNAL THRESHOLDS
# ============================================================================

# Aggressive mode (more signals, lower confidence)
AGGRESSIVE_MIN_SCORE=0.1
AGGRESSIVE_MIN_VECTOR=0.6

# Neutral mode (balanced)
NEUTRAL_MIN_SCORE=0.2
NEUTRAL_MIN_VECTOR=0.7

# Conservative mode (fewer signals, higher confidence)
CONSERVATIVE_MIN_SCORE=0.4
CONSERVATIVE_MIN_VECTOR=0.8
